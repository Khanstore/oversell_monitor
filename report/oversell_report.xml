<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Printable vendor/shortage report: A4 landscape, narrow margins (~0.5 inch). -->
    <record id="paperformat_oversell_landscape" model="report.paperformat">
        <field name="name">A4 Landscape – Oversell Monitor (Narrow Margins)</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">12.7</field>
        <field name="margin_bottom">12.7</field>
        <field name="margin_left">12.7</field>
        <field name="margin_right">12.7</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">4</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_oversell_monitor" model="ir.actions.report">
        <field name="name">Stock Shortage &amp; Vendor Report</field>
        <field name="model">oversell.monitor.line</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">oversell_monitor.report_oversell_monitor_template</field>
        <field name="report_file">oversell_monitor.report_oversell_monitor_template</field>
        <field name="paperformat_id" ref="paperformat_oversell_landscape"/>
        <field name="binding_model_id" ref="model_oversell_monitor_line"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_oversell_monitor_template">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <div class="page" style="font-family:Arial,sans-serif;font-size:9pt;color:#202b36;">
                    <style>
                        .osm-title { text-align:center; font-size:16pt; font-weight:700; margin:0 0 4px 0; color:#16324f; }
                        .osm-meta { text-align:center; font-size:8.5pt; margin:0 0 12px 0; color:#526170; }
                        .osm-area { text-align:center; background:#16324f; color:#fff; font-weight:700; padding:5px 7px; margin-top:8px; font-size:9.5pt; page-break-after:avoid; }
                        table.osm-table { width:100%; border-collapse:collapse; table-layout:fixed; margin:0 0 9px 0; }
                        .osm-table thead { display:table-header-group; }
                        .osm-table th { background:#eaf0f6; color:#1c2e40; font-size:8pt; font-weight:700; text-align:center; padding:6px 5px; border:0.7px solid #273746; }
                        .osm-table td { font-size:8.2pt; padding:5px 5px; border:0.6px solid #59636e; vertical-align:top; overflow-wrap:anywhere; }
                        .osm-table tbody tr:nth-child(even) td { background:#f7f9fb; }
                        .osm-center { text-align:center; }
                        .osm-right { text-align:right; }
                        .osm-muted { color:#596a7b; font-size:7.5pt; }
                        .osm-total td { background:#eaf0f6 !important; font-weight:700; border-top:1.2px solid #16324f; }
                    </style>
                    <h2 class="osm-title">Stock Shortage &amp; Vendor Report</h2>
                    <div class="osm-meta">
                        Date: <t t-esc="context_timestamp(datetime.datetime.now()).strftime('%d %B %Y')"/>
                        &#160; | &#160; Company: <t t-esc="res_company.name"/>
                        &#160; | &#160; Report lines: <t t-esc="len(docs)"/>
                    </div>
                    <t t-if="not docs">
                        <p style="text-align:center;padding:24px;border:1px solid #ccd5de;">No shortage records match the selected records or filters.</p>
                    </t>
                    <t t-foreach="list(dict.fromkeys(docs.mapped('vendor_area')))" t-as="area">
                        <t t-set="area_lines" t-value="docs.filtered(lambda r: r.vendor_area == area)"/>
                        <div class="osm-area"><t t-esc="area or 'Unknown'"/></div>
                        <table class="osm-table">
                            <thead>
                                <tr>
<!--                                    <th style="width:14%;">Place</th>-->
                                    <th style="width:19%;">Vendor and Mobile Number</th>
                                    <th style="width:23%;">Product Variant</th>
                                    <th style="width:10%;">Shortage</th>
                                    <th style="width:10%;">Avg Price</th>
                                    <th style="width:11%;">Last Purchase</th>
                                    <th style="width:27%;">Comment</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="area_lines" t-as="line">
                                    <tr>
<!--                                        <td><t t-esc="line.vendor_area or 'Unknown'"/></td>-->
                                        <td>
                                            <strong><t t-esc="line.vendor_name or 'Unknown vendor'"/></strong>
                                            <t t-if="line.vendor_id and (line.vendor_id.mobile or line.vendor_id.phone)">
                                                <br/><span><t t-esc="line.vendor_id.mobile or line.vendor_id.phone"/></span>
                                            </t>
                                        </td>
                                        <td>
                                            <t t-esc="line.product_name or ''"/>
                                            <t t-if="line.default_code"><br/><span class="osm-muted">SKU: <t t-esc="line.default_code"/></span></t>
                                        </td>
                                        <td class="osm-center">
                                            <strong><t t-esc="'{:,.2f}'.format(line.deficit_qty or 0.0)"/></strong>
                                            <t t-if="line.product_id and line.product_id.uom_id"><br/><span class="osm-muted"><t t-esc="line.product_id.uom_id.name"/></span></t>
                                        </td>
                                        <td class="osm-right"><span t-field="line.avg_cost" t-options="{'widget': 'monetary', 'display_currency': line.currency_id}"/></td>
                                        <td class="osm-right"><span t-field="line.last_purchase_price" t-options="{'widget': 'monetary', 'display_currency': line.currency_id}"/></td>
                                        <td>
                                            <t t-if="line.order_name"><strong><t t-esc="line.order_name"/></strong><br/></t>
                                            <t t-if="line.order_state"><span class="osm-muted"><t t-esc="dict(line._fields['order_state'].selection).get(line.order_state, line.order_state)"/></span></t>
                                            <t t-if="line.restock_eta"><br/><span class="osm-muted">ETA: <t t-esc="line.restock_eta.strftime('%d %b %Y')"/></span></t>
                                            <t t-if="not line.order_name and not line.restock_eta"><span class="osm-muted">—</span></t>
                                        </td>
                                    </tr>
                                </t>
                                <tr class="osm-total">
                                    <td colspan="3" class="osm-right">Place total</td>
                                    <td class="osm-center"><t t-esc="'{:,.2f}'.format(sum(area_lines.mapped('deficit_qty')) or 0.0)"/></td>
                                    <td colspan="3"></td>
                                </tr>
                            </tbody>
                        </table>
                    </t>
                    <div class="osm-muted" style="margin-top:8px;border-top:1px solid #ccd5de;padding-top:5px;">
                        Generated from the Oversell Monitor records. Shortage is the currently reported deficit; quotations sent are potential demand and are not confirmed sales commitments.
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
