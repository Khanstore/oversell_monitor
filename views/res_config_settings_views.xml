<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_oversell_config_form" model="ir.ui.view">
        <field name="name">oversell.monitor.settings.form</field>
        <field name="model">oversell.monitor.settings</field>
        <field name="arch" type="xml">
            <form string="Oversell Monitor Settings">
                <sheet>
                    <div class="o_setting_container">

                        <div class="o_settings_section">
                            <h2>Digest Emails</h2>
                            <div class="row mt16">
                                <div class="col-12 col-lg-6 o_setting_box">
                                    <div class="o_setting_left_pane">
                                        <field name="digest_enabled" widget="boolean_toggle"/>
                                    </div>
                                    <div class="o_setting_right_pane">
                                        <label for="digest_enabled" string="Enable Scheduled Digest"/>
                                        <div class="text-muted">
                                            Send a summary of oversell lines to stock managers on a schedule.
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12 col-lg-6 o_setting_box">
                                    <div class="o_setting_left_pane"/>
                                    <div class="o_setting_right_pane">
                                        <label for="digest_frequency" string="Digest Frequency"/>
                                        <field name="digest_frequency"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="o_settings_section">
                            <h2>Stock Thresholds</h2>
                            <div class="row mt16">
                                <div class="col-12 col-lg-6 o_setting_box">
                                    <div class="o_setting_left_pane"/>
                                    <div class="o_setting_right_pane">
                                        <label for="global_min_threshold" string="Global Min Stock Threshold"/>
                                        <div class="text-muted">
                                            Flag risk when stock falls below this level. 0 = disabled.
                                        </div>
                                        <field name="global_min_threshold"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="o_settings_section">
                            <h2>Automatic Notifications</h2>
                            <div class="row mt16">
                                <div class="col-12 col-lg-6 o_setting_box">
                                    <div class="o_setting_left_pane">
                                        <field name="auto_notify_vendor" widget="boolean_toggle"/>
                                    </div>
                                    <div class="o_setting_right_pane">
                                        <label for="auto_notify_vendor" string="Auto-notify Vendors"/>
                                        <div class="text-muted">
                                            Email the primary vendor automatically when an oversell occurs.
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12 col-lg-6 o_setting_box">
                                    <div class="o_setting_left_pane">
                                        <field name="auto_notify_customer" widget="boolean_toggle"/>
                                    </div>
                                    <div class="o_setting_right_pane">
                                        <label for="auto_notify_customer" string="Auto-notify Customers"/>
                                        <div class="text-muted">
                                            Email the customer automatically when their order is oversold.
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </sheet>
                <footer>
                    <button string="Save" name="action_save"
                            type="object" class="btn-primary"/>
                    <button string="Discard" name="action_discard"
                            type="object" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_oversell_config" model="ir.actions.act_window">
        <field name="name">Oversell Monitor Settings</field>
        <field name="res_model">oversell.monitor.settings</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_oversell_config_form"/>
        <field name="target">current</field>
    </record>

</odoo>
