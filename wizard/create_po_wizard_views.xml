<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_oversell_create_po_wizard_form" model="ir.ui.view">
        <field name="name">oversell.create.po.wizard.form</field>
        <field name="model">oversell.create.po.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Purchase Order">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        <i class="fa fa-info-circle"/>
                        Review and adjust quantities. One Purchase Order will be created per vendor.
                    </div>
                    <group>
                        <field name="scheduled_date" string="Requested Delivery Date"/>
                        <field name="note" string="Notes" placeholder="Optional notes for the vendor..."/>
                    </group>
                    <field name="line_ids" nolabel="1">
                        <list editable="bottom" string="Products to Order">
                            <field name="product_id" readonly="0"/>
                            <field name="vendor_id"/>
                            <field name="deficit_qty" string="Deficit" readonly="1"/>
                            <field name="qty_to_order" string="Qty to Order"/>
                            <field name="last_purchase_price" string="Unit Price"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_create_po" string="Create Purchase Order(s)"
                            type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
